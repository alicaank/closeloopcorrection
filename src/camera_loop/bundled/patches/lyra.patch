+    def flash_apply_rotary_emb(x, cos, sin, interleaved=True, inplace=False):
+        """Torch fallback for the sole FlashAttention utility used by Lyra.
+
+        Attention itself is handled by Transformer Engine.  The released code
+        unnecessarily made FlashAttention mandatory for this small RoPE helper;
+        sm_120 is unsupported by Lyra's pinned FlashAttention 2.6.3 build.  This
+        implements its interleaved pair rotation exactly and remains autograd-safe.
+        """
+        if not interleaved:
+            raise NotImplementedError("Lyra's fallback only supports interleaved RoPE")
+        if inplace:
+            raise NotImplementedError("Lyra never requests in-place RoPE")
+        if x.shape[-1] != 2 * cos.shape[-1] or cos.shape != sin.shape:
+            raise ValueError(
+                f"invalid rotary shapes: x={tuple(x.shape)} cos={tuple(cos.shape)} sin={tuple(sin.shape)}"
+            )
+        pairs = x.unflatten(-1, (-1, 2))
+        view_shape = (1, cos.shape[0], 1, cos.shape[1])
+        cos_b = cos.view(view_shape)
+        sin_b = sin.view(view_shape)
+        even, odd = pairs[..., 0], pairs[..., 1]
+        return torch.stack((even * cos_b - odd * sin_b, even * sin_b + odd * cos_b), dim=-1).flatten(-2)
 
