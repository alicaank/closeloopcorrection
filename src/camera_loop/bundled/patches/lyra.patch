+def save_png_sequence(video_cthw: torch.Tensor, output_dir: str) -> None:
+    """Save a C,T,H,W tensor in [0,1] without video-codec distortion."""
+    if video_cthw.ndim != 4 or video_cthw.shape[0] not in (1, 3, 4):
+        raise ValueError(f"expected C,T,H,W video, got {tuple(video_cthw.shape)}")
+    os.makedirs(output_dir, exist_ok=True)
+    frames_thwc = (
+        video_cthw.clamp(0, 1)
+        .permute(1, 2, 3, 0)
+        .mul(255.0)
+        .round()
+        .to(torch.uint8)
+        .numpy()
+    )
+    for frame_index, rgb in enumerate(frames_thwc):
+        if rgb.shape[-1] == 1:
+            encoded = rgb[..., 0]
+        else:
+            encoded = cv2.cvtColor(rgb[..., :3], cv2.COLOR_RGB2BGR)
+        path = os.path.join(output_dir, f"frame_{frame_index:05d}.png")
+        if not cv2.imwrite(path, encoded):
+            raise OSError(f"failed to write {path}")
+
+
